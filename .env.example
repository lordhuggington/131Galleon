# Copy to .env and fill in. Never commit .env.

# Text-message sign-in (Twilio Verify). Create a Verify service in the Twilio console and copy all
# three values; leave any of them blank to disable SMS sign-in (owners can still use a password).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# The address Claude reaches this app on. Used for the OAuth metadata and the connector URL; no trailing slash.
HRS_PUBLIC_URL=https://galleon.casa
# SQLite file (inside the container this is on the ./data volume)
HRS_DB_PATH=/data/house.db
# Where visit photos are stored (inside the container this is on the ./data volume)
HRS_PHOTOS_DIR=/data/photos
# Keep true in production (HTTPS). Set to 0 only for local http://localhost development.
HRS_COOKIE_SECURE=true
# How long a login lasts
HRS_SESSION_DAYS=30

# Only needed if you run the bundled Cloudflare Tunnel (docker compose --profile tunnel up -d)
CLOUDFLARE_TUNNEL_TOKEN=
